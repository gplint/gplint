{
	"name": "gplint",
	"version": "2.6.0",
	"description": "A Gherkin linter/validator written in Javascript.",
	"author": "Luis Zurro",
	"homepage": "https://gplint.github.io",
	"repository": {
		"type": "git",
		"url": "https://github.com/gplint/gplint"
	},
	"bugs": {
		"url": "https://github.com/gplint/gplint/issues"
	},
	"funding": [
		{
			"type": "ko-fi",
			"url": "https://ko-fi.com/nyaran"
		},
		{
			"type": "Buy me a coffee",
			"url": "https://www.buymeacoffee.com/nyaran"
		}
	],
	"license": "ISC",
	"keywords": [
		"gherkin",
		"pickle",
		"cucumber",
		"cucumberjs",
		"linter",
		"lint"
	],
	"type": "module",
	"exports": "./build/index.js",
	"bin": {
		"gplint": "bin/gplint.js"
	},
	"scripts": {
		"clean": "rimraf ./build",
		"compile": "tsc",
		"compile:watch": "npm run compile -- --watch --listFiles",
		"prebuild": "node -p \"'export const LIB_VERSION = \\'' + require('./package.json').version + '\\';'\" > src/version.ts",
		"build": "run-s clean compile",
		"postbuild": "node -p \"'export const LIB_VERSION = \\'0.0.0\\';'\" > src/version.ts",
		"prepare": "npm run build",
		"demo": "node ./build/cli/index.js -c ./test-data-wip/.gplintrc test-data-wip/**",
		"lint": "eslint --max-warnings 0 src test",
		"test": "run-s -c -n lint test:unit:cov",
		"test:unit": "cross-env NODE_ENV=test mocha --recursive",
		"test:unit:cov": "c8 npm run test:unit"
	},
	"types": "./build/index.d.ts",
	"dependencies": {
		"@cucumber/gherkin": "42.0.1",
		"@cucumber/gherkin-streams": "7.0.1",
		"@cucumber/messages": "34.2.1",
		"lodash.camelcase": "^4.3.0",
		"lodash.castarray": "^4.4.0",
		"lodash.findkey": "^4.6.0",
		"lodash.foreach": "^4.5.0",
		"lodash.groupby": "^4.6.0",
		"lodash.intersection": "^4.4.0",
		"lodash.intersectionby": "^4.7.0",
		"lodash.isempty": "^4.4.0",
		"lodash.isnumber": "^3.0.3",
		"lodash.isregexp": "^4.0.1",
		"lodash.kebabcase": "^4.1.1",
		"lodash.lowerfirst": "^4.3.1",
		"lodash.merge": "^4.6.2",
		"lodash.range": "^3.2.0",
		"lodash.snakecase": "^4.1.1",
		"lodash.sortby": "^4.7.0",
		"lodash.startcase": "^4.4.0",
		"lodash.tonumber": "^4.18.0",
		"lodash.trim": "^4.18.0",
		"lodash.uniqby": "^4.7.0",
		"lodash.upperfirst": "^4.3.1",
		"lodash.words": "^4.2.0",
		"strip-json-comments": "5.0.3",
		"text-table": "0.2.0",
		"tinyglobby": "^0.2.17",
		"xml-js": "1.6.11",
		"yargs": "18.1.0"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/chai": "5.2.3",
		"@types/lodash.camelcase": "^4.3.9",
		"@types/lodash.castarray": "^4.4.9",
		"@types/lodash.findkey": "^4.6.9",
		"@types/lodash.foreach": "^4.5.9",
		"@types/lodash.groupby": "^4.6.9",
		"@types/lodash.intersection": "^4.4.9",
		"@types/lodash.intersectionby": "^4.7.9",
		"@types/lodash.isempty": "^4.4.9",
		"@types/lodash.isnumber": "^3.0.9",
		"@types/lodash.isregexp": "^4.0.9",
		"@types/lodash.kebabcase": "^4.1.9",
		"@types/lodash.lowerfirst": "^4.3.9",
		"@types/lodash.merge": "^4.6.9",
		"@types/lodash.range": "^3.2.9",
		"@types/lodash.snakecase": "^4.1.9",
		"@types/lodash.sortby": "^4.7.9",
		"@types/lodash.startcase": "^4.4.9",
		"@types/lodash.tonumber": "^4.0.9",
		"@types/lodash.trim": "^4.5.9",
		"@types/lodash.uniqby": "^4.7.9",
		"@types/lodash.upperfirst": "^4.3.9",
		"@types/lodash.words": "^4.2.9",
		"@types/mocha": "10.0.10",
		"@types/mock-fs": "4.13.4",
		"@types/node": "26.4.0",
		"@types/sinon": "22.0.0",
		"@types/text-table": "0.2.5",
		"@types/yargs": "17.0.35",
		"c8": "12.0.0",
		"chai": "6.2.2",
		"cross-env": "10.1.0",
		"eslint": "10.9.1",
		"eslint-plugin-chai-friendly": "1.2.1",
		"eslint-plugin-promise": "7.3.0",
		"mocha": "12.0.0",
		"mocha-multi-reporters": "1.5.1",
		"mock-fs": "5.5.0",
		"npm-run-all": "4.1.5",
		"rimraf": "6.1.3",
		"sinon": "22.1.0",
		"tsx": "4.21.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.68.0"
	},
	"optionalDependencies": {
		"ts-node": "^10.9.2",
		"tsx": "^4.21.0"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"directories": {
		"lib": "./src",
		"test": "./test"
	},
	"files": [
		"/build",
		"/CHANGELOG.md"
	]
}
